# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# PostgreSQL connection string for production
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:password@localhost:5432/sharks_db?schema=public"

# ==============================================================================
# JWT CONFIGURATION
# ==============================================================================
# CRITICAL: Change these secrets in production!
# Generate strong secrets using: openssl rand -base64 64

# Access Token Secret (15 minutes expiry)
JWT_ACCESS_SECRET="your-super-secret-access-key-change-in-production-min-32-chars"

# Refresh Token Secret (7 days expiry)
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production-min-32-chars"

# Token expiration times
JWT_ACCESS_EXPIRATION="15m"   # 15 minutes
JWT_REFRESH_EXPIRATION="7d"   # 7 days

# ==============================================================================
# PASSWORD RESET CONFIGURATION
# ==============================================================================
# Password reset token expiration (1 hour)
PASSWORD_RESET_EXPIRATION="1h"

# Password reset URL (frontend)
PASSWORD_RESET_URL="http://localhost:3000/auth/reset-password"

# ==============================================================================
# SECURITY CONFIGURATION
# ==============================================================================
# Bcrypt rounds (10-12 for production, higher = more secure but slower)
BCRYPT_ROUNDS=12

# Maximum failed login attempts before account lock
MAX_LOGIN_ATTEMPTS=5

# Account lock duration in minutes
ACCOUNT_LOCK_DURATION=30

# ==============================================================================
# EMAIL CONFIGURATION (Optional - for password reset emails)
# ==============================================================================
# SMTP Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-specific-password"

# Email sender
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_FROM_NAME="Sharks App"

# ==============================================================================
# OAUTH CONFIGURATION (Optional)
# ==============================================================================
# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# GitHub OAuth
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_CALLBACK_URL="http://localhost:4000/auth/github/callback"

# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================
# Application port
PORT=4000

# Node environment
NODE_ENV="development"

# API prefix
API_PREFIX="api"

# CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# ==============================================================================
# REDIS CONFIGURATION (Optional - for token blacklist)
# ==============================================================================
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================
# Log level: debug, info, warn, error
LOG_LEVEL="info"

# Log format: json, pretty
LOG_FORMAT="pretty"

# ==============================================================================
# RATE LIMITING (Optional - for DDoS protection)
# ==============================================================================
RATE_LIMIT_TTL=60          # Time window in seconds
RATE_LIMIT_MAX_REQUESTS=100 # Max requests per window
