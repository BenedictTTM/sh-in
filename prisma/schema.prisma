
generator client {
  provider = "prisma-client-js"
  // Optimize for production performance
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql" // Use PostgreSQL for production
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER MODEL
// ============================================================================
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255) // bcrypt hash
  firstName String   @map("first_name") @db.VarChar(100)
  lastName  String   @map("last_name") @db.VarChar(100)
  school    String?  @db.VarChar(255)
  profilePicture String? @map("profile_picture") @db.Text

  // Account Status
  isActive        Boolean  @default(true) @map("is_active")
  isEmailVerified Boolean  @default(false) @map("is_email_verified")
  emailVerifiedAt DateTime? @map("email_verified_at")

  // Security
  lastLoginAt     DateTime? @map("last_login_at")
  lastLoginIp     String?   @map("last_login_ip") @db.VarChar(45)
  failedLoginAttempts Int   @default(0) @map("failed_login_attempts")
  lockedUntil     DateTime? @map("locked_until")

  // OAuth
  googleId  String? @unique @map("google_id") @db.VarChar(255)
  githubId  String? @unique @map("github_id") @db.VarChar(255)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete

  // Relations
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  quizzes             Quiz[]
  attempts            Attempt[]
  stats               UserStats?
  activityLogs        UserActivityLog[]

  @@index([email])
  @@index([googleId])
  @@index([githubId])
  @@index([createdAt])
  @@map("users")
}

// ============================================================================
// USER STATS MODEL
// ============================================================================
model UserStats {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  
  // Progression
  xp        Int      @default(0)
  gems      Int      @default(0)
  currentLevel Int   @default(1) @map("current_level")
  
  // Premium Currency
  diamonds  Int      @default(0)
  
  // Streaks
  dayStreak      Int      @default(0) @map("day_streak")
  lastActivityAt DateTime? @map("last_activity_at")
  
  // Achievement
  top3Finishes   Int      @default(0) @map("top_3_finishes")
  totalStudyTimeSeconds BigInt @default(0) @map("total_study_time_seconds")
  
  // Energy System
  energy         Int      @default(5)
  maxEnergy      Int      @default(5) @map("max_energy")
  lastEnergyRefillAt DateTime @default(now()) @map("last_energy_refill_at")
  
  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_stats")
}

// ============================================================================
// USER ACTIVITY LOG MODEL
// ============================================================================
// Heatmap data tracking daily activity
model UserActivityLog {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  activityDate    DateTime @map("activity_date") @db.Date // Store only date part
  
  // Metrics
  studySeconds    Int      @default(0) @map("study_seconds")
  quizzesSolved   Int      @default(0) @map("quizzes_solved")
  
  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityDate]) // One log per user per day
  @@index([userId])
  @@index([activityDate])
  @@map("user_activity_logs")
}

// ============================================================================
// REFRESH TOKEN MODEL
// ============================================================================
// Implements secure token rotation and device tracking
model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.VarChar(255) // SHA-256 hash
  
  // Token metadata
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  revokedAt DateTime? @map("revoked_at")
  
  // Device tracking for multi-device support
  deviceId       String? @map("device_id") @db.VarChar(255)
  deviceName     String? @map("device_name") @db.VarChar(255)
  deviceType     String? @map("device_type") @db.VarChar(50) // mobile, desktop, tablet
  userAgent      String? @map("user_agent") @db.Text
  ipAddress      String? @map("ip_address") @db.VarChar(45)
  
  // Token family for rotation tracking (prevents replay attacks)
  tokenFamily String? @map("token_family") @db.VarChar(255)
  
  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([isRevoked])
  @@index([deviceId])
  @@index([tokenFamily])
  @@map("refresh_tokens")
}

// ============================================================================
// PASSWORD RESET TOKEN MODEL
// ============================================================================
// Secure one-time password reset tokens with expiration
model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.VarChar(255) // SHA-256 hash
  
  // Token lifecycle
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  usedAt    DateTime? @map("used_at")
  
  // Security tracking
  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.Text
  
  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([isUsed])
  @@map("password_reset_tokens")
}

// ============================================================================
// QUIZ MODEL
// ============================================================================
model Quiz {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  description String?  @db.Text
  
  // Quiz Configuration
  timeLimit   Int?     @map("time_limit") // in seconds, null = no limit
  passingScore Int?    @map("passing_score") // minimum score to pass
  maxAttempts Int?     @map("max_attempts") // null = unlimited
  
  // Publishing
  isPublished Boolean  @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  
  // Ownership
  createdById Int      @map("created_by_id")
  
  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at") // Soft delete
  
  // Relations
  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  questions   Question[]
  attempts    Attempt[]
  
  @@index([isPublished])
  @@index([createdById])
  @@index([createdAt])
  @@map("quizzes")
}

// ============================================================================
// QUESTION MODEL
// ============================================================================
model Question {
  id          Int      @id @default(autoincrement())
  quizId      Int      @map("quiz_id")
  
  // Question Content
  text        String   @db.Text
  explanation String?  @db.Text // shown after answer
  solution    String?  @db.Text // Detailed step-by-step solution
  points      Int      @default(1) // points for correct answer
  
  // Question Configuration
  order       Int      // display order in quiz
  type        String   @default("single_choice") @db.VarChar(50) // single_choice, multiple_choice, etc.
  
  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  choices     Choice[]
  answers     Answer[]
  
  @@index([quizId])
  @@index([order])
  @@map("questions")
}

// ============================================================================
// CHOICE MODEL
// ============================================================================
model Choice {
  id          Int      @id @default(autoincrement())
  questionId  Int      @map("question_id")
  
  // Choice Content
  text        String   @db.Text
  isCorrect   Boolean  @default(false) @map("is_correct")
  order       Int      // display order
  
  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers     Answer[]
  
  @@index([questionId])
  @@map("choices")
}

// ============================================================================
// ATTEMPT MODEL
// ============================================================================
model Attempt {
  id          Int      @id @default(autoincrement())
  quizId      Int      @map("quiz_id")
  userId      Int      @map("user_id")
  
  // Attempt Tracking
  attemptToken String  @unique @map("attempt_token") @db.VarChar(255) // secure token for validation
  
  // Attempt Status
  status      String   @default("in_progress") @db.VarChar(50) // in_progress, completed, expired
  
  // Scoring
  score       Int      @default(0)
  maxScore    Int      @map("max_score")
  
  // Timing
  startedAt   DateTime @default(now()) @map("started_at")
  expiresAt   DateTime? @map("expires_at")
  finishedAt  DateTime? @map("finished_at")
  
  // Metadata
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text
  
  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Restrict)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers     Answer[]
  
  @@index([quizId])
  @@index([userId])
  @@index([attemptToken])
  @@index([status])
  @@index([startedAt])
  @@map("attempts")
}

// ============================================================================
// ANSWER MODEL
// ============================================================================
model Answer {
  id              Int      @id @default(autoincrement())
  attemptId       Int      @map("attempt_id")
  questionId      Int      @map("question_id")
  choiceId        Int      @map("choice_id")
  
  // Answer Validation
  isCorrect       Boolean  @map("is_correct")
  pointsAwarded   Int      @default(0) @map("points_awarded")
  
  // Idempotency
  idempotencyKey  String   @unique @map("idempotency_key") @db.VarChar(255)
  
  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  
  // Relations
  attempt         Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  choice          Choice   @relation(fields: [choiceId], references: [id], onDelete: Restrict)
  
  @@unique([attemptId, questionId]) // One answer per question per attempt
  @@index([attemptId])
  @@index([questionId])
  @@index([idempotencyKey])
  @@map("answers")
}

// ============================================================================
// CURRENCY TRANSACTION MODEL
// ============================================================================
// Audit trail for all currency movements (energy, diamonds, gems)
model CurrencyTransaction {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  
  // Transaction Details
  type        String   @db.VarChar(50) // energy_refill, energy_consume, diamond_purchase, diamond_spend, etc.
  currency    String   @db.VarChar(20) // energy, diamonds, gems
  amount      Int      // positive for credit, negative for debit
  
  // Balance Tracking
  balanceBefore Int    @map("balance_before")
  balanceAfter  Int    @map("balance_after")
  
  // Metadata
  reason      String?  @db.VarChar(255) // quiz_play, shop_purchase, refill, etc.
  metadata    Json?    // additional context (quiz_id, product_id, etc.)
  
  // Idempotency
  idempotencyKey String? @unique @map("idempotency_key") @db.VarChar(255)
  
  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@index([userId])
  @@index([type])
  @@index([currency])
  @@index([createdAt])
  @@map("currency_transactions")
}
